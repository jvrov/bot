# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel.
# Tudo aqui é gratuito.

# Remetente dos avisos. No Gmail use uma "senha de app":
# https://myaccount.google.com/apppasswords
EMAIL_USER=seu-bot@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=Price Monitor <seu-bot@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Banco de dados Upstash Redis (plano grátis). Na Vercel são criadas sozinhas
# ao conectar o banco em Storage. Sem elas, os dados ficam em data.json.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=...

# Protege a rota /api/cron (verificação automática diária)
# CRON_SECRET=uma-string-aleatoria-grande
