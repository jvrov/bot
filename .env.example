# Copie para .env (ou configure no painel da Vercel) e preencha.

# Remetente dos alertas. Para Gmail use uma "senha de app":
# https://myaccount.google.com/apppasswords
EMAIL_USER=seu-bot@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Opcionais
# EMAIL_FROM=Price Monitor <seu-bot@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Busca inteligente com IA (opcional). Sem ela, o site usa regras simples.
# Crie em https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Banco de dados (Redis / Upstash). Sem isso, os dados ficam em data.json.
# REDIS_URL=rediss://default:senha@host:6379

# Protege a rota /api/cron (verificação automática)
# CRON_SECRET=uma-string-aleatoria-grande

# Usado só pela CLI (price_monitor.py)
# ALERT_EMAIL=voce@exemplo.com
